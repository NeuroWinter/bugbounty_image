#!/bin/bash
set -euo pipefail

[ $# -eq 0 ] && echo "Usage: scope-check <target>" && exit 1

SCOPE="${SCOPE_FILE:-$HOME/scope/authorized.txt}"
TARGET="$1"

if [ ! -f "$SCOPE" ]; then
    echo "No scope file. Create: echo '*.example.com' > ~/scope/authorized.txt"
    exit 1
fi

while read -r line; do
    [[ -z "$line" || "$line" =~ ^# ]] && continue
    pattern=$(echo "$line" | sed 's/\./\\./g' | sed 's/\*/.*/')
    [[ "$TARGET" =~ ^${pattern}$ ]] && echo "✅ In scope" && exit 0
done < "$SCOPE"

echo "❌ NOT in scope"
echo "Authorized: $(grep -v '^#' "$SCOPE" | grep -v '^$' | tr '\n' ' ')"
exit 1
